<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SilentNetwork" parent="Theme.AppCompat.NoActionBar">
        <!-- Window background and status bar -->
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Brand colors -->
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryDark">@color/bg_canvas</item>
        <item name="colorAccent">@color/accent_cyan</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
